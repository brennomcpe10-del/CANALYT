rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Channel configuration is readable by everyone, writable by anyone (or admin)
    match /channel_config/{document} {
      allow read, write: if true;
    }

    // Registered users collection
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
